# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Apex domain used for {tenant}.{ROOT_DOMAIN} subdomain routing.
ROOT_DOMAIN=localhost
LOG_LEVEL=info

# --- Auth ---
# Signs the session cookie. Required (>= 32 chars) in production.
SESSION_SECRET=dev-only-session-secret-change-me-please
# Role-switcher at /demo. Disable in production.
DEMO_AUTH_ENABLED=true

# --- Stripe ---
# `sk_test_mock` runs against an in-process mock Stripe client.
STRIPE_SECRET_KEY=sk_test_mock
# Leave blank in mock mode to accept unsigned webhook payloads (local only).
# When set, signatures are always verified (also in mock mode).
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=price_pro_mock
STRIPE_PRICE_ENTERPRISE=price_enterprise_mock

# --- Email ---
EMAIL_FROM=bookings@clinicbook.app
